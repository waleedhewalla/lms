# Copy to infra/.env and fill in. Never commit the real file.
EDUNEXUS_VERSION=1.3.0

# --- Production identity (required when ASPNETCORE_ENVIRONMENT=Production) ---
ASPNETCORE_ENVIRONMENT=Production
OIDC_AUTHORITY=https://idp.example.edu/realms/edunexus
OIDC_AUDIENCE=edunexus-api
OIDC_WEB_CLIENT_ID=edunexus-web
ENABLE_DEV_TOKEN=false

# --- Public URLs (what browsers use) ---
WEB_ORIGIN=https://edunexus.example.edu
API_PUBLIC_URL=https://api.edunexus.example.edu

# --- Secrets: replace every value ---
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=edunexus
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
RABBITMQ_USER=edunexus
RABBITMQ_PASSWORD=change-me

# Optional operations link in the web header
GRAFANA_URL=

# --- AI (optional; Echo = built-in extractive drafts, no external calls) ---
AI_PROVIDER=Echo
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
