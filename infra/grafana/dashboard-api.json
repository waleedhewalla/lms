{
  "title": "EduNexus API",
  "tags": ["edunexus"],
  "panels": [
    {
      "title": "Request rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_server_request_duration_count[5m]))" }]
    },
    {
      "title": "p95 latency",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_bucket[5m])) by (le))" }]
    },
    {
      "title": "5xx rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_server_request_duration_count{http_response_status_code=~\"5..\"}[5m]))" }]
    },
    {
      "title": "Kestrel connections",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "kestrel_active_connections" }]
    },
    {
      "title": ".NET GC collections",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(dotnet_gc_collections_total) by (gc_heap_generation)" }]
    }
  ]
}
